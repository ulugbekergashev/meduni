# MedUni — UNIVERSITET SERVERI uchun muhit o'zgaruvchilari.
#
#   cp .env.server.example .env
#
# (Bulutga — Render/Vercel/Supabase — o'rnatish uchun boshqa fayl:
#  .env.deploy.example. Ikkalasini aralashtirmang.)
#
# To'liq qo'llanma: README.server.md

# ── MAJBURIY ────────────────────────────────────────────────────────────

# Baza paroli. Konteyner ichidagi PostgreSQL shu parol bilan ko'tariladi.
# Yaratish:  openssl rand -hex 24
DB_PASSWORD=

# Sessiya kalitlari. HAR BIRI ALOHIDA tasodifiy qiymat.
# Yaratish:  openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Sayt domeni — sxemasiz, "https://" YOZILMAYDI.
# TLS profili (--profile tls) shu domenga sertifikat oladi.
DOMAIN=meduni.example.uz

# Sun'iy intellekt kalitlari har KAFEDRA tomonidan platformada kiritiladi
# (Xodimlar -> kafedra sahifasi). Quyidagilar serverga yoziladi:
#
# Kafedra kalitlarini shifrlash siri. BIR MARTA qo'ying: openssl rand -hex 32
# ⚠️ Keyin o'zgartirmang — saqlangan kalitlar o'qilmay qoladi.
AI_KEY_SECRET=
#
# IXTIYORIY umumiy (zaxira) kalit: kalit kiritmagan kafedralar shuni ishlatadi.
# Bo'sh qoldirsangiz har kafedra faqat o'z kalitida ishlaydi.
GEMINI_API_KEY=

# ── IXTIYORIY ───────────────────────────────────────────────────────────

# Node uchun xotira chegarasi, MB. Serverning RAM'iga qarab:
#   8 GB → 2048     16 GB → 4096     32 GB → 8192
# ⚠️ Image ichidagi sukut qiymat 400 (bulutdagi bepul tarif uchun edi) —
#    uni shu yerda ko'tarmasangiz video montaji xotira yetmay yiqiladi.
NODE_HEAP_MB=2048

# Video kadr balandligi. Bulutda 720 edi (kuchsiz protsessor).
VIDEO_HEIGHT=1080

# Konteyner qaysi manzilga chiqadi.
# Caddy (--profile tls) ishlatilsa — shundayligicha qoldiring.
# Universitetning O'Z proxy'si bo'lsa — uni shu portga yo'naltiring.
# Proxy boshqa mashinada bo'lsa: APP_BIND=0.0.0.0
APP_BIND=127.0.0.1
APP_PORT=8080

# Birinchi ishga tushirishda demo akkauntlar yaratiladi (tekshirish uchun).
# Haqiqiy foydalanuvchilar kiritilgach 0 qiling va qayta ishga tushiring.
DEMO_SEED=1

# ── WebAuthn (passkey bilan yo'qlama) ───────────────────────────────────
# RP_ID — sxemasiz domen, ORIGIN — sxema bilan. DOMAIN bilan bir xil bo'lsin.
WEBAUTHN_RP_ID=meduni.example.uz
WEBAUTHN_ORIGIN=https://meduni.example.uz

# ── Geofence (ixtiyoriy) ────────────────────────────────────────────────
# Berilmasa GPS tekshiruvi o'chiq turadi.
# CAMPUS_LAT=41.311081
# CAMPUS_LNG=69.240562
# CAMPUS_RADIUS_M=300
