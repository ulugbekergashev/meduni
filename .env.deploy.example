# MedUni — muhit o'zgaruvchilari namunasi.
#
# Bu qiymatlar Render (API) va Vercel (web) panellariga kiritiladi —
# fayl sifatida serverga yuklanmaydi. To'liq qo'llanma: README.deploy.md
#
# Mahalliy dev / docker-compose uchun:  cp .env.deploy.example .env

# ---------------------------------------------------------------- RENDER (API)

# Supabase → Connect → Session pooler (port 5432, IPv4).
# ⚠️ Direct connection (db.xxx.supabase.co) IPv6 — Render undan chiqa olmaydi.
DATABASE_URL=postgresql://postgres.REF:PAROL@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# JWT sekretlari — tasodifiy uzun matn. Yaratish:  openssl rand -hex 32
JWT_ACCESS_SECRET=BU_YERGA_TASODIFIY_HEX
JWT_REFRESH_SECRET=BU_YERGA_BOSHQA_TASODIFIY_HEX

# Gemini API kaliti. ⚠️ Eskisi chatga yozilgan — pilotdan oldin YANGILANG.
GEMINI_API_KEY=BU_YERGA_GEMINI_KALIT

# Web qayerda turadi (CORS). Bir nechta bo'lsa vergul bilan, oxirida "/" YO'Q.
WEB_ORIGIN=https://meduni.vercel.app

# Vercel loyiha nomi — preview deploy'larga (meduni-git-*.vercel.app) ruxsat.
VERCEL_PROJECT=meduni

# Web va API har xil domenda → cookie SameSite=None; Secure bo'lishi SHART.
# ⚠️ Busiz login "o'tadi" lekin sessiya saqlanmaydi.
CROSS_SITE_COOKIES=1

NODE_ENV=production
PORT=8080

# Birinchi ishga tushishda demo akkauntlarni yozish (keyin 0 qilib qo'ying).
DEMO_SEED=1

# WebAuthn check-in (passkey bilan yo'qlama). RP_ID — sxemasiz domen!
WEBAUTHN_RP_ID=meduni.vercel.app
WEBAUTHN_ORIGIN=https://meduni.vercel.app

# Geofence (ixtiyoriy) — berilmasa GPS tekshiruvi o'chiq.
# CAMPUS_LAT=41.311081
# CAMPUS_LNG=69.240562
# CAMPUS_RADIUS_M=300

# ---------------------------------------------------------------- VERCEL (web)
#
# Vercel panelida FAQAT shu bittasi:
#   VITE_API_URL=https://meduni-api.onrender.com
#
# ⚠️ Build paytida bundle ichiga yoziladi — o'zgartirsangiz Redeploy shart.
