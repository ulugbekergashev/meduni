# Bu faylni VM'da `.env` deb nusxalang va to'ldiring:  cp .env.deploy.example .env
# docker compose shu `.env` dan ${...} qiymatlarni oladi.

# JWT sekretlari — tasodifiy uzun matn. Yaratish (VM'da):
#   openssl rand -hex 32
JWT_ACCESS_SECRET=BU_YERGA_TASODIFIY_HEX
JWT_REFRESH_SECRET=BU_YERGA_BOSHQA_TASODIFIY_HEX

# Gemini API kaliti (AI generatsiya uchun). ⚠️ Pilotdan oldin yangi kalit oling.
GEMINI_API_KEY=BU_YERGA_GEMINI_KALIT
