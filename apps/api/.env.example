# Postgres (matches docker-compose.yml at repo root)
DATABASE_URL=postgresql://meduni:meduni@localhost:5432/meduni

# Auth
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# AI providers. Gemini is the default for text, images and speech;
# set AI_*_PROVIDER to route a given modality elsewhere (see apps/api/src/ai/config.ts).
AI_TEXT_PROVIDER=gemini
AI_IMAGE_PROVIDER=pollinations
AI_TTS_PROVIDER=edge-tts
GEMINI_API_KEY=
FFMPEG_PATH=

PORT=8000
WEB_ORIGIN=http://localhost:3000
