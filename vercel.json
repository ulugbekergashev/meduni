{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --ignore-scripts --include=dev && npm rebuild esbuild",
  "buildCommand": "npm run build --workspace=@meduni/web",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://meduni-api.onrender.com/api/:path*" },
    { "source": "/auth/:path*", "destination": "https://meduni-api.onrender.com/auth/:path*" },
    { "source": "/health", "destination": "https://meduni-api.onrender.com/health" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
