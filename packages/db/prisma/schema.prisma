generator client {
  provider = "prisma-client-js"
  // relationJoins — bog'langan ma'lumotni BITTA SQL bilan olish imkonini beradi
  // (`relationLoadStrategy: "join"`). Sukut bo'yicha Prisma har bog'lanish uchun
  // alohida so'rov yuboradi; baza uzoq regionda bo'lganda (har so'rov ~150ms)
  // bitta sahifa 25-30 so'rovga bo'linib, soniyalab kutish paydo bo'ladi.
  // ⚠️ Opt-in: faqat aniq belgilangan og'ir so'rovlarda ishlatiladi.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  FACULTY_ADMIN
  DEPT_ADMIN
  TEACHER
  STUDENT
}

enum Locale {
  uz
  ru
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
}

enum TopicStatus {
  DRAFT
  PUBLISHED
}

enum ParseStatus {
  PENDING
  PROCESSING
  DONE
  ERROR
}

enum ContentKind {
  QUIZ
  CASE
  PRESENTATION
  VIDEO
}

enum ContentStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
}

enum Difficulty {
  RECALL
  UNDERSTAND
  APPLY
}

enum CaseFormat {
  SHORT
  EXTENDED
}

enum VideoBuildStatus {
  PENDING
  SCRIPT
  TTS
  RENDER
  DONE
  ERROR
}

enum FactcheckStatus {
  NONE
  CHECKING
  FLAGGED
  CLEAN
  RESOLVED
}

enum ProgressState {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum TaskStatus {
  OPEN
  DONE
  DISMISSED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

model User {
  id             Int             @id @default(autoincrement())
  fullName       String
  email          String          @unique
  phone          String?
  passwordHash   String
  role           Role
  locale         Locale          @default(uz)
  isActive       Boolean         @default(true)
  groupId        Int?
  group          StudentGroup?   @relation(fields: [groupId], references: [id])
  // Admin-tier scopes: FACULTY_ADMIN is pinned to a faculty, DEPT_ADMIN to a department.
  facultyId         Int?
  faculty           Faculty?        @relation("FacultyAdmins", fields: [facultyId], references: [id])
  adminDepartmentId Int?
  adminDepartment   Department?     @relation("DepartmentAdmins", fields: [adminDepartmentId], references: [id])
  teacherProfile    TeacherProfile?
  taughtCourses     Course[]         @relation("CourseTeacher")
  enrollments       Enrollment[]
  uploadedMaterials SourceMaterial[]
  approvedContent   ContentItem[]    @relation("ContentApprover")
  auditLogs         AuditLog[]
  progress          Progress[]
  overriddenProgress Progress[]      @relation("ProgressOverrider")
  editedPolicies     LearningPolicy[] @relation("PolicyEditor")
  remediationAnswers RemediationAnswer[]
  sectionReads      SectionRead[]
  flashcardReviews  FlashcardReview[]
  tutorMessages     TutorMessage[]
  patientMessages   PatientMessage[]
  chatMessages      CourseChatMessage[] @relation("ChatAuthor")
  quizAttempts      QuizAttempt[]
  caseAttempts      CaseAttempt[]    @relation("CaseStudent")
  reviewedCases     CaseAttempt[]    @relation("CaseReviewer")
  createdSessions   LessonSession[]  @relation("SessionCreator")
  attendanceMarked  Attendance[]     @relation("AttendanceMarker")
  attendanceRecords Attendance[]     @relation("AttendanceStudent")
  attendanceChanges AttendanceChange[] @relation("AttendanceChanger")
  aiUsage           AiUsage[]
  tasksCreated      Task[]           @relation("TaskCreator")
  tasksAssigned     Task[]           @relation("TaskAssignee")
  webauthnCredentials WebAuthnCredential[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@map("users")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  actorId     Int
  actor       User     @relation(fields: [actorId], references: [id])
  action      String
  entity      String
  entityId    Int
  detailsJson Json?
  createdAt   DateTime @default(now())

  @@map("audit_logs")
}

model TeacherProfile {
  id           Int        @id @default(autoincrement())
  userId       Int        @unique
  user         User       @relation(fields: [userId], references: [id])
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  position     String?
  bio          String?
  createdAt    DateTime   @default(now())

  @@map("teacher_profiles")
}

model Faculty {
  id          Int            @id @default(autoincrement())
  name        String
  createdAt   DateTime       @default(now())
  departments Department[]
  groups      StudentGroup[]
  admins      User[]         @relation("FacultyAdmins")

  @@unique([name])
  @@map("faculties")
}

model Department {
  id        Int       @id @default(autoincrement())
  facultyId Int
  faculty   Faculty   @relation(fields: [facultyId], references: [id])
  name      String
  createdAt DateTime  @default(now())
  courses   Course[]
  teachers  TeacherProfile[]
  aiUsage   AiUsage[]
  aiQuota   AiQuota?
  admins    User[]           @relation("DepartmentAdmins")

  @@unique([facultyId, name])
  @@map("departments")
}

model AiQuota {
  id                Int        @id @default(autoincrement())
  departmentId      Int        @unique
  department        Department @relation(fields: [departmentId], references: [id])
  monthlyTokenLimit Int        @default(0) // 0 = unlimited
  monthlyImageLimit Int        @default(0)
  monthlyCostLimit  Float      @default(0)

  @@map("ai_quotas")
}

model StudentGroup {
  id          Int      @id @default(autoincrement())
  facultyId   Int
  faculty     Faculty  @relation(fields: [facultyId], references: [id])
  name         String
  yearOfStudy  Int
  // O'qituvchi yaratgan guruh — hali kursga biriktirilmagan bo'lsa ham "Mening
  // guruhlarim"da ko'rinishi uchun (skalyar, relation shart emas).
  createdById  Int?
  createdAt    DateTime      @default(now())
  students     User[]
  courseGroups CourseGroup[]

  @@unique([facultyId, name])
  @@map("student_groups")
}

model Course {
  id           Int           @id @default(autoincrement())
  departmentId Int
  department   Department    @relation(fields: [departmentId], references: [id])
  name         String
  description  String?
  teacherId    Int
  teacher      User          @relation("CourseTeacher", fields: [teacherId], references: [id])
  semester              Int
  academicYear          String
  defaultUnlockRuleJson Json?
  syllabusJson          Json?
  // Ochilish shartlari — MUSTAQIL, birga ishlashi mumkin:
  //  sequentialUnlock: mavzu oldingisi tugagach ochiladi (ketma-ketlik).
  //  scheduleUnlock:   mavzu o'z dars kunidan keyin ochiladi (jadval).
  // Ikkalasi yoniq bo'lsa — HAR IKKALA shart bajarilishi kerak.
  sequentialUnlock      Boolean       @default(true)
  scheduleUnlock        Boolean       @default(false)
  createdAt             DateTime      @default(now())
  courseGroups          CourseGroup[]
  enrollments           Enrollment[]
  sessions              LessonSession[]
  chatMessages          CourseChatMessage[]
  topics                Topic[]
  scheduleSlots         ScheduleSlot[]

  @@map("courses")
}

/// Haftalik TAKRORIY jadval: kurs har hafta shu kun+vaqtda o'tiladi. O'qituvchi
/// bir marta sozlaydi — darslar avtomatik hosil bo'ladi (qo'lda yaratilmaydi).
/// Yo'qlama belgilanganda o'sha (kurs, sana) uchun LessonSession lazy yaratiladi.
model ScheduleSlot {
  id        Int      @id @default(autoincrement())
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // Qaysi GURUH uchun — bir kurs bir necha guruhga har xil kunda o'tilishi mumkin.
  // null = kursning barcha guruhlariga (eski/legacy).
  groupId   Int?
  weekday   Int // 0=Dushanba .. 6=Yakshanba
  startTime String // "09:00"
  room      String?
  createdAt DateTime @default(now())

  @@index([courseId])
  @@map("schedule_slots")
}

/// Kurs guruh chati (Modul 25) — kurs o'qituvchisi + shu kursga yozilgan
/// talabalar. Dars ichidagi AI-chatdan farqli: bu real odamlar muloqoti.
model CourseChatMessage {
  id        Int      @id @default(autoincrement())
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User     @relation("ChatAuthor", fields: [authorId], references: [id])
  text      String
  createdAt DateTime @default(now())

  @@index([courseId, createdAt])
  @@map("course_chat_messages")
}

model Topic {
  id             Int              @id @default(autoincrement())
  courseId       Int
  course         Course           @relation(fields: [courseId], references: [id])
  title          String
  orderIndex     Int
  status         TopicStatus      @default(DRAFT)
  unlockRuleJson Json?
  hours          Int              @default(0)
  syllabusNote   String?
  createdAt      DateTime         @default(now())
  materials      SourceMaterial[]
  links          TopicLink[]
  digest         TopicDigest?
  podcast        TopicPodcast?
  contentItems   ContentItem[]
  progress       Progress[]
  sectionReads   SectionRead[]
  flashcardReviews FlashcardReview[]
  tutorMessages  TutorMessage[]
  patientMessages PatientMessage[]
  sessions       LessonSession[]

  @@map("topics")
}

/// Virtual bemor roleplay (Modul 26) — AI bemor rolini o'ynaydi, talaba
/// shifokor sifatida anamnez yig'adi; yakunda AI baholaydi. role="eval"
/// bo'lgan xabar matni JSON baholash (frontend parse qiladi).
model PatientMessage {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   User     @relation(fields: [studentId], references: [id])
  topicId   Int
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  /// "student" | "patient" | "eval" | "test" | "scenario"
  role      String
  text      String
  /// role="test": {indicated, reason, cost} — tekshiruv BUYURILGAN paytda
  /// yozib qo'yiladi (jonli ball shundan hisoblanadi, qayta AI so'ramaydi).
  metaJson  Json?
  createdAt DateTime @default(now())

  @@index([studentId, topicId, createdAt])
  @@map("patient_messages")
}

model LessonSession {
  id          Int          @id @default(autoincrement())
  courseId    Int
  course      Course       @relation(fields: [courseId], references: [id])
  // Yo'qlama qaysi GURUH uchun (bir kurs bir necha guruhga o'tilsa ajratiladi).
  groupId     Int?
  topicId     Int?
  topic       Topic?       @relation(fields: [topicId], references: [id])
  date        DateTime
  title       String?
  room        String?
  createdById Int
  createdBy   User         @relation("SessionCreator", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  attendance  Attendance[]

  /// Bitta dars = (kurs, guruh, aniq sana+vaqt). Ilgari na unique, na indeks bor
  /// edi: `ensureSession` bir vaqtda ikki marta chaqirilsa ikkita sessiya yaratardi
  /// va yo'qlama ikkiga bo'linib ketardi (2026-09-08 auditi).
  /// ⚠️ Postgres'da NULL lar unique'da o'zaro TENG EMAS — legacy `groupId = null`
  /// qatorlar bu cheklovga tushmaydi (ular baribir eskirgan yo'l).
  @@unique([courseId, groupId, date])
  @@index([courseId, date])
  @@index([groupId, date])
  @@map("lesson_sessions")
}

/// Yo'qlama belgisining O'ZGARISH jurnali (edi → bo'ldi).
/// ⚠️ NEGA: retro-tuzatish — universitetdagi klassik suiiste'mol vektori
/// (semestr oxirida "nb" larni jimgina "sababli" ga aylantirish). AuditLog'da
/// faqat `{count}` qolardi, ya'ni kimning belgisi nimadan nimaga o'zgargani
/// tiklanmasdi. Bu jadval — dekanat nazorati uchun (F5 "chetlanishlar").
model AttendanceChange {
  id           Int               @id @default(autoincrement())
  attendanceId Int
  attendance   Attendance        @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  /// null = belgi birinchi marta qo'yildi.
  prevStatus   AttendanceStatus?
  newStatus    AttendanceStatus
  byId         Int
  by           User              @relation("AttendanceChanger", fields: [byId], references: [id])
  reason       String?
  at           DateTime          @default(now())

  @@index([attendanceId])
  @@index([at])
  @@map("attendance_changes")
}

model Attendance {
  id         Int              @id @default(autoincrement())
  sessionId  Int
  session    LessonSession    @relation(fields: [sessionId], references: [id])
  studentId  Int
  student    User             @relation("AttendanceStudent", fields: [studentId], references: [id])
  status     AttendanceStatus
  grade      Int?
  markedById Int
  markedBy   User             @relation("AttendanceMarker", fields: [markedById], references: [id])
  // Talaba o'zi telefonidan FaceID (WebAuthn) + GPS bilan check-in qildimi.
  // markedById=talabaning o'zi bo'ladi; o'qituvchi qo'lda o'zgartirsa false ga tushadi.
  selfMarked Boolean          @default(false)
  markedAt   DateTime         @updatedAt
  changes    AttendanceChange[]

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@map("attendance")
}

/// Talaba telefonidagi FaceID/barmoq passkey (WebAuthn) — o'zi davomat check-in
/// qilishi uchun. Biometrika qurilmada qoladi; serverda faqat ochiq kalit saqlanadi.
model WebAuthnCredential {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique // base64url
  publicKey    String // base64url
  counter      Int       @default(0)
  transports   String?
  deviceName   String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
  @@map("webauthn_credentials")
}

model Progress {
  id               Int           @id @default(autoincrement())
  studentId        Int
  student          User          @relation(fields: [studentId], references: [id])
  topicId          Int
  topic            Topic         @relation(fields: [topicId], references: [id])
  state            ProgressState @default(LOCKED)
  videoWatchedPct  Int           @default(0)
  videoPositionSec Int           @default(0)
  slidesViewed     Boolean       @default(false)
  completedAt      DateTime?
  overriddenAt     DateTime?
  overriddenById   Int?
  overriddenBy     User?         @relation("ProgressOverrider", fields: [overriddenById], references: [id])
  /// Мотив ручного допуска (код из закрытого списка) и пояснение.
  /// Без мотива допуск не выдаётся — иначе «допущен» неотличим от «освоил».
  overrideReason   String?
  overrideNote     String?
  updatedAt        DateTime      @updatedAt

  @@unique([studentId, topicId])
  @@map("progress")
}

model ContentItem {
  id              Int           @id @default(autoincrement())
  topicId         Int
  topic           Topic         @relation(fields: [topicId], references: [id])
  kind            ContentKind
  language        Locale
  status          ContentStatus @default(DRAFT)
  approvedById       Int?
  approvedBy         User?           @relation("ContentApprover", fields: [approvedById], references: [id])
  approvedAt         DateTime?
  version            Int             @default(1)
  reviewOpenedAt     DateTime?
  editedByTeacher    Boolean         @default(false)
  factcheckFlagsJson Json?
  factcheckStatus    FactcheckStatus @default(NONE)
  factcheckedAt      DateTime?
  createdAt          DateTime        @default(now())
  quiz            Quiz?
  clinicalCase    ClinicalCase?
  presentation    Presentation?
  video           Video?

  @@unique([topicId, kind])
  @@map("content_items")
}

model Video {
  id            Int              @id @default(autoincrement())
  contentItemId Int              @unique
  contentItem   ContentItem      @relation(fields: [contentItemId], references: [id])
  scriptJson    Json
  audioUrl      String?
  mp4Url        String?
  srtUrl        String?
  durationSec   Int?
  voiceId       String?
  language      Locale
  buildStatus   VideoBuildStatus @default(PENDING)
  errorStage    String?

  @@map("videos")
}

/// КОРИДОР ПОЛИТИКИ (2026-08-11, требование руководства «жёсткий контроль»).
/// Минимальные требования задаёт институт, а не преподаватель. Уровни:
/// UNIVERSITY (scopeId = null) → FACULTY → DEPARTMENT. Ниже по иерархии можно
/// только УЖЕСТОЧИТЬ: resolveRule берёт максимум из порогов и OR из флагов.
/// Преподаватель работает внутри коридора; сервер отклоняет выход за него.
model LearningPolicy {
  id      Int          @id @default(autoincrement())
  level   PolicyLevel
  /// FACULTY → Faculty.id, DEPARTMENT → Department.id, UNIVERSITY → null.
  scopeId Int?

  /// Проходной балл теста не может быть ниже этого значения.
  minQuizPassedPct   Int     @default(70)
  /// Просмотр видео (если видео есть) не ниже.
  minVideoWatchedPct Int     @default(80)
  /// Тема обязана иметь хотя бы одно оценивание (тест или кейс), иначе
  /// не засчитывается автоматически.
  requireAssessment  Boolean @default(true)
  /// Последовательное открытие тем нельзя выключить.
  requireSequential  Boolean @default(true)
  /// Клинический кейс обязателен, если он есть в теме.
  requireCase        Boolean @default(true)
  /// Кейс должен быть проверен преподавателем.
  requireCaseReviewed Boolean @default(false)

  /// Пересдачи: сколько попыток теста разрешено (не меньше). 1 = без пересдач.
  minQuizAttempts    Int     @default(3)
  /// Верхняя граница — чтобы «бесконечные попытки» не обесценили тест.
  maxQuizAttempts    Int     @default(5)
  /// Пауза между попытками (часы) — не меньше.
  minAttemptGapHours Int     @default(24)
  /// Перед повторной попыткой обязателен разбор своих ошибок.
  requireRemediation Boolean @default(true)
  /// Ограничение времени теста (минут на вопрос), 0 = без ограничения.
  minMinutesPerQuestion Int  @default(1)

  /// Разрешён ли ручной допуск вообще и обязателен ли мотив.
  allowManualUnlock  Boolean @default(true)
  /// ОЧНЫЙ РЕЖИМ: кафедра может потребовать присутствия для ВСЕХ тестов.
  /// Отдельный тест включает очность сам (Quiz.requiresPresence).
  requirePresence    Boolean @default(false)

  updatedById Int?
  updatedBy   User?    @relation("PolicyEditor", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([level, scopeId])
  @@map("learning_policies")
}

enum PolicyLevel {
  UNIVERSITY
  FACULTY
  DEPARTMENT
}

model Quiz {
  id            Int         @id @default(autoincrement())
  contentItemId Int         @unique
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id])
  passThreshold Int         @default(70)
  maxAttempts   Int         @default(1)
  /// Пауза между попытками (часы). 0 = без паузы. Реальное значение
  /// зажимается коридором политики (minAttemptGapHours).
  attemptGapHours Int       @default(0)
  /// ОЧНЫЙ РЕЖИМ: попытку можно начать только в день занятия и только если
  /// преподаватель отметил студента присутствующим. Для итоговых испытаний —
  /// единственное, что реально отвечает на «сдал сам или друг».
  requiresPresence Boolean  @default(false)
  /// Vaqt chegarasi (daqiqa). 0 = cheklanmagan. Test boshlanganda
  /// QuizAttempt.expiresAt shunga qarab hisoblanadi.
  timeLimitMin  Int         @default(0)
  settingsJson  Json?
  questions     Question[]
  attempts      QuizAttempt[]

  @@map("quizzes")
}

model QuizAttempt {
  id          Int       @id @default(autoincrement())
  quizId      Int
  quiz        Quiz      @relation(fields: [quizId], references: [id])
  studentId   Int
  student     User      @relation(fields: [studentId], references: [id])
  answersJson Json      @default("{}") // { [questionId]: selectedIndex }
  /// Talaba "belgilab qo'ygan" savollar (keyin qaytish uchun): questionId[].
  flaggedJson Json      @default("[]")
  scorePct    Int       @default(0)
  passed      Boolean   @default(false)
  attemptNo   Int       @default(1)
  startedAt   DateTime  @default(now())
  /// Vaqt tugash momenti (timeLimitMin > 0 bo'lsa). Server shu vaqtdan keyin
  /// urinishni avtomatik yakunlaydi — klient soatiga ishonilmaydi.
  expiresAt   DateTime?
  finishedAt  DateTime?
  /// СНИМОК ВАРИАНТА: порядок вопросов и перестановка вариантов ответа,
  /// свои для КАЖДОЙ попытки. Сосед видит другой экран, на пересдаче — другой
  /// порядок. Ответы хранятся в ИСХОДНЫХ индексах, перевод делает сервер.
  orderJson   Json?
  /// Устройство, начавшее попытку. Продолжить с другого нельзя — это закрывает
  /// самый простой сценарий «друг сдаёт за меня со своего телефона».
  deviceHash  String?
  /// Сигналы честности: уход со вкладки, вставка из буфера, аномальная скорость.
  /// ⚠️ Это ПОДСКАЗКА преподавателю, а не автоматическое обвинение.
  integrityJson Json?

  @@map("quiz_attempts")
}

/// ДОКАЗАТЕЛЬСТВО разбора ошибок. Раньше тренажёр «работа над ошибками» не
/// оставлял следа (комментарий в practice.ts: «на оценку и прогресс не влияет»),
/// поэтому нельзя было ни доказать, что студент доучил, ни поставить это
/// условием пересдачи. Теперь каждый ответ в тренажёре фиксируется.
model RemediationAnswer {
  id            Int      @id @default(autoincrement())
  studentId     Int
  student       User     @relation(fields: [studentId], references: [id])
  /// Попытка, ошибки которой разбираются.
  attemptId     Int
  questionId    Int
  selectedIndex Int
  correct       Boolean
  createdAt     DateTime @default(now())

  @@index([studentId, attemptId])
  @@map("remediation_answers")
}

model Question {
  id             Int        @id @default(autoincrement())
  quizId         Int
  quiz           Quiz       @relation(fields: [quizId], references: [id])
  text           String
  optionsJson    Json
  correctIndex   Int
  explanationJson Json
  difficulty     Difficulty @default(RECALL)
  sourceFragment String?
  orderIndex     Int
  /// Вопрос выведен из оборота (правка/перегенерация теста). НЕ удаляется
  /// физически: иначе ранее сданные попытки теряют связь с вопросами и
  /// оценку невозможно проверить задним числом.
  retiredAt      DateTime?

  @@map("questions")
}

model ClinicalCase {
  id            Int           @id @default(autoincrement())
  contentItemId Int           @unique
  contentItem   ContentItem   @relation(fields: [contentItemId], references: [id])
  caseJson      Json
  format        CaseFormat    @default(SHORT)
  attempts      CaseAttempt[]

  @@map("clinical_cases")
}

model CaseAttempt {
  id              Int          @id @default(autoincrement())
  caseId          Int
  clinicalCase    ClinicalCase @relation(fields: [caseId], references: [id])
  studentId       Int
  student         User         @relation("CaseStudent", fields: [studentId], references: [id])
  answersJson     Json // string[] paired with case questions (v1 erkin matn)
  /// v2 — qadam-qadam tanlangan variantlar: { [stepIndex]: optionIndex }.
  /// Bo'sh bo'lsa keys eski (erkin matnli) formatда topshirilgan.
  stepsJson       Json         @default("{}")
  /// v2 — qadamlar bo'yicha avto-baho (to'g'ri qarorlar ulushi, 0-100).
  /// Erkin matnli qismni baribir o'qituvchi baholaydi (gibrid baholash).
  autoScore       Int?
  /// Modul 28 — AI tavsiyaviy baho keshи ({score, rationale, missed[]}).
  /// FAQAT tavsiya: yakuniy bahoni o'qituvchi qo'yadi.
  aiSuggestJson   Json?
  submittedAt     DateTime     @default(now())
  teacherFeedback String?
  score           Int?
  reviewedById    Int?
  reviewedBy      User?        @relation("CaseReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?

  @@unique([studentId, caseId])
  @@map("case_attempts")
}

model Presentation {
  id            Int         @id @default(autoincrement())
  contentItemId Int         @unique
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id])
  slidesJson    Json
  pptxUrl       String?
  pdfUrl        String?

  @@map("presentations")
}

model TopicDigest {
  id                Int      @id @default(autoincrement())
  topicId           Int      @unique
  topic             Topic    @relation(fields: [topicId], references: [id])
  digestJson        Json
  version           Int      @default(1)
  approvedByTeacher Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("topic_digests")
}

/// Audio-podkast (~20 daqiqa) — mavzuni TO'LIQ ochadigan ikki ovozli suhbat.
/// Konspektning har bo'limi uchun alohida bob yoziladi (AI), keyin har replika
/// alohida ovozlanadi va bitta m4a ga birlashtiriladi. Bu MP4 emas — faqat ovoz,
/// shuning uchun 512 MB konteynerda ham xavfsiz (§17 video montaji saboqi).
model TopicPodcast {
  id            Int              @id @default(autoincrement())
  topicId       Int              @unique
  topic         Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  /// Qaysi konspekt versiyasidan yozilgan — konspekt tahrirlansa podkast eskiradi.
  digestVersion Int              @default(1)
  language      Locale           @default(uz)
  /// PodcastSegment[] — replika matni, ovoz, davomiylik, kesh hash'i.
  scriptJson    Json
  audioUrl      String?
  durationSec   Int?
  buildStatus   VideoBuildStatus @default(PENDING)
  errorStage    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("topic_podcasts")
}

model AiUsage {
  id               Int         @id @default(autoincrement())
  kind             String
  topicId          Int?
  departmentId     Int?
  department       Department? @relation(fields: [departmentId], references: [id])
  userId           Int?
  user             User?       @relation(fields: [userId], references: [id])
  model            String
  promptTokens     Int         @default(0)
  completionTokens Int         @default(0)
  totalTokens      Int         @default(0)
  images           Int         @default(0)
  ttsChars         Int         @default(0)
  costUsd          Float       @default(0)
  createdAt        DateTime    @default(now())

  @@index([departmentId, createdAt])
  @@map("ai_usage")
}

/// Doimiy fayl saqlash. Render Free'da disk VAQTINCHALIK — konteyner har
/// restart/redeploy'da noldan ko'tariladi va `/app/storage` bo'shab qoladi
/// (yuklangan material, generatsiya qilingan rasm/video/audio yo'qoladi).
/// Shuning uchun prod'da fayllar shu jadvalda yashaydi; `path` — eski disk
/// yo'li bilan AYNAN bir xil (masalan "topics/12/video/3/video.mp4"), ya'ni
/// boshqa jadvallardagi mavjud url qiymatlari o'zgarishsiz ishlayveradi.
model FileBlob {
  path      String   @id
  data      Bytes
  mimeType  String?
  size      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("file_blobs")
}

model SourceMaterial {
  id            Int         @id @default(autoincrement())
  topicId       Int
  topic         Topic       @relation(fields: [topicId], references: [id])
  fileUrl       String
  fileName      String
  fileType      String
  /// Talabaga ko'rsatiladigan metama'lumot ("PDF · 24 bet · 2.1 MB").
  /// pageCount faqat parse aniqlay olsa to'ladi — aks holda UI uni yashiradi
  /// (soxta raqam ko'rsatilmaydi).
  sizeBytes     Int?
  pageCount     Int?
  parsedTextUrl String?
  parseStatus   ParseStatus @default(PENDING)
  parseError    String?
  uploadedById  Int
  uploadedBy    User        @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime    @default(now())

  @@map("source_materials")
}

/// Mavzuga biriktirilgan tashqi manba (darslik bobi, klinik ma'lumotnoma).
/// O'qituvchi qo'shadi; talaba chap panelda "Tashqi havola" sifatida ko'radi.
model TopicLink {
  id        Int      @id @default(autoincrement())
  topicId   Int
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title     String
  url       String
  /// Ixtiyoriy izoh ("Guyton & Hall, 11-bob").
  note      String?
  orderIndex Int     @default(0)
  createdAt DateTime @default(now())

  @@index([topicId])
  @@map("topic_links")
}

/// Dars ichidagi AI-tutor suhbati — talaba + AI (jonli o'qituvchi EMAS,
/// foydalanuvchi spetsifikatsiyasi bo'yicha). Suhbat = (studentId, topicId).
model TutorMessage {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   User     @relation(fields: [studentId], references: [id])
  topicId   Int
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  /// "student" | "assistant"
  role      String
  text      String
  createdAt DateTime @default(now())

  @@index([studentId, topicId, createdAt])
  @@map("tutor_messages")
}

/// Fleshkarta ko'rib chiqilishi (takrorlash uchun). Kartalar mavjud
/// ma'lumotdan hosil qilinadi (test savollari + konspekt atamalari) — alohida
/// AI generatsiyasi yo'q. cardKey: "q:<questionId>" yoki "t:<index>".
/// Keyinchalik interval-takrorlash (spaced repetition) shu jadvaldan o'sadi.
model FlashcardReview {
  id         Int      @id @default(autoincrement())
  studentId  Int
  student    User     @relation(fields: [studentId], references: [id])
  topicId    Int
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  cardKey    String
  known      Boolean
  /// Interval takrorlash (Modul 26): joriy interval (kun) va navbatdagi takror
  /// sanasi. "bilaman" → interval o'sadi, "bilmayman" → 1 kunga qaytadi.
  intervalDays Int      @default(0)
  dueAt        DateTime?
  reviewedAt   DateTime @updatedAt

  @@unique([studentId, topicId, cardKey])
  @@index([studentId, topicId])
  @@index([studentId, dueAt])
  @@map("flashcard_reviews")
}

/// Konspekt bo'limi o'qilganini kuzatish (1a "O'qildi 2/6").
/// Progress'dan alohida: Progress mavzu darajasida, bu bo'lim darajasida.
model SectionRead {
  id           Int      @id @default(autoincrement())
  studentId    Int
  student      User     @relation(fields: [studentId], references: [id])
  topicId      Int
  topic        Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  sectionIndex Int
  readAt       DateTime @default(now())

  @@unique([studentId, topicId, sectionIndex])
  @@index([studentId, topicId])
  @@map("section_reads")
}

model CourseGroup {
  id       Int          @id @default(autoincrement())
  courseId Int
  course   Course       @relation(fields: [courseId], references: [id])
  groupId  Int
  group    StudentGroup @relation(fields: [groupId], references: [id])
  // Sikl (blok) davri: kurs shu guruhga qaysi sanalar oralig'ida o'tiladi.
  // Darslar faqat shu oraliqda hosil bo'ladi (null = cheksiz/legacy).
  cycleStart DateTime?
  cycleEnd   DateTime?

  @@unique([courseId, groupId])
  @@map("course_groups")
}

model Enrollment {
  id        Int              @id @default(autoincrement())
  studentId Int
  student   User             @relation(fields: [studentId], references: [id])
  courseId  Int
  course    Course           @relation(fields: [courseId], references: [id])
  status    EnrollmentStatus @default(ACTIVE)
  createdAt DateTime         @default(now())

  @@unique([studentId, courseId])
  @@map("enrollments")
}

// Manually-assigned task (admin -> teacher/department, teacher -> student/group).
// Auto-derived tasks are NOT stored here — they are computed live.
model Task {
  id           Int          @id @default(autoincrement())
  title        String
  description  String?
  status       TaskStatus   @default(OPEN)
  priority     TaskPriority @default(NORMAL)
  dueDate      DateTime?
  createdById  Int
  createdBy    User         @relation("TaskCreator", fields: [createdById], references: [id])
  assignedToId Int
  assignedTo   User         @relation("TaskAssignee", fields: [assignedToId], references: [id])
  departmentId Int?
  courseId     Int?
  groupId      Int?
  topicId      Int?
  linkUrl      String?
  batchId      String? // groups a group/department fan-out into one logical assignment
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([assignedToId, status])
  @@index([createdById])
  @@index([batchId])
  @@map("tasks")
}
