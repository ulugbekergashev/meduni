generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum Locale {
  uz
  ru
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
}

enum TopicStatus {
  DRAFT
  PUBLISHED
}

enum ParseStatus {
  PENDING
  PROCESSING
  DONE
  ERROR
}

enum ContentKind {
  QUIZ
  CASE
  PRESENTATION
  VIDEO
}

enum ContentStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
}

enum Difficulty {
  RECALL
  UNDERSTAND
  APPLY
}

enum CaseFormat {
  SHORT
  EXTENDED
}

model User {
  id             Int             @id @default(autoincrement())
  fullName       String
  email          String          @unique
  phone          String?
  passwordHash   String
  role           Role
  locale         Locale          @default(uz)
  isActive       Boolean         @default(true)
  groupId        Int?
  group          StudentGroup?   @relation(fields: [groupId], references: [id])
  teacherProfile    TeacherProfile?
  taughtCourses     Course[]         @relation("CourseTeacher")
  enrollments       Enrollment[]
  uploadedMaterials SourceMaterial[]
  approvedContent   ContentItem[]    @relation("ContentApprover")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@map("users")
}

model TeacherProfile {
  id           Int        @id @default(autoincrement())
  userId       Int        @unique
  user         User       @relation(fields: [userId], references: [id])
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  position     String?
  bio          String?
  createdAt    DateTime   @default(now())

  @@map("teacher_profiles")
}

model Faculty {
  id          Int            @id @default(autoincrement())
  nameUz      String
  nameRu      String
  createdAt   DateTime       @default(now())
  departments Department[]
  groups      StudentGroup[]

  @@unique([nameUz])
  @@unique([nameRu])
  @@map("faculties")
}

model Department {
  id        Int       @id @default(autoincrement())
  facultyId Int
  faculty   Faculty   @relation(fields: [facultyId], references: [id])
  nameUz    String
  nameRu    String
  createdAt DateTime  @default(now())
  subjects  Subject[]
  teachers  TeacherProfile[]

  @@unique([facultyId, nameUz])
  @@unique([facultyId, nameRu])
  @@map("departments")
}

model Subject {
  id           Int        @id @default(autoincrement())
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  nameUz       String
  nameRu       String
  description  String?
  createdAt    DateTime   @default(now())
  courses      Course[]

  @@unique([departmentId, nameUz])
  @@unique([departmentId, nameRu])
  @@map("subjects")
}

model StudentGroup {
  id          Int      @id @default(autoincrement())
  facultyId   Int
  faculty     Faculty  @relation(fields: [facultyId], references: [id])
  name         String
  yearOfStudy  Int
  createdAt    DateTime      @default(now())
  students     User[]
  courseGroups CourseGroup[]

  @@unique([facultyId, name])
  @@map("student_groups")
}

model Course {
  id           Int           @id @default(autoincrement())
  subjectId    Int
  subject      Subject       @relation(fields: [subjectId], references: [id])
  teacherId    Int
  teacher      User          @relation("CourseTeacher", fields: [teacherId], references: [id])
  semester     Int
  academicYear String
  createdAt    DateTime      @default(now())
  courseGroups CourseGroup[]
  enrollments  Enrollment[]
  topics       Topic[]

  @@map("courses")
}

model Topic {
  id             Int              @id @default(autoincrement())
  courseId       Int
  course         Course           @relation(fields: [courseId], references: [id])
  titleUz        String
  titleRu        String
  orderIndex     Int
  status         TopicStatus      @default(DRAFT)
  unlockRuleJson Json?
  createdAt      DateTime         @default(now())
  materials      SourceMaterial[]
  digest         TopicDigest?
  contentItems   ContentItem[]

  @@map("topics")
}

model ContentItem {
  id              Int           @id @default(autoincrement())
  topicId         Int
  topic           Topic         @relation(fields: [topicId], references: [id])
  kind            ContentKind
  language        Locale
  status          ContentStatus @default(DRAFT)
  approvedById    Int?
  approvedBy      User?         @relation("ContentApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  version         Int           @default(1)
  reviewOpenedAt  DateTime?
  editedByTeacher Boolean       @default(false)
  createdAt       DateTime      @default(now())
  quiz            Quiz?
  clinicalCase    ClinicalCase?

  @@unique([topicId, kind])
  @@map("content_items")
}

model Quiz {
  id            Int         @id @default(autoincrement())
  contentItemId Int         @unique
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id])
  passThreshold Int         @default(70)
  maxAttempts   Int         @default(1)
  settingsJson  Json?
  questions     Question[]

  @@map("quizzes")
}

model Question {
  id             Int        @id @default(autoincrement())
  quizId         Int
  quiz           Quiz       @relation(fields: [quizId], references: [id])
  text           String
  optionsJson    Json
  correctIndex   Int
  explanationJson Json
  difficulty     Difficulty @default(RECALL)
  sourceFragment String?
  orderIndex     Int

  @@map("questions")
}

model ClinicalCase {
  id            Int         @id @default(autoincrement())
  contentItemId Int         @unique
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id])
  caseJson      Json
  format        CaseFormat  @default(SHORT)

  @@map("clinical_cases")
}

model TopicDigest {
  id                Int      @id @default(autoincrement())
  topicId           Int      @unique
  topic             Topic    @relation(fields: [topicId], references: [id])
  digestJson        Json
  version           Int      @default(1)
  approvedByTeacher Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("topic_digests")
}

model AiUsage {
  id               Int      @id @default(autoincrement())
  kind             String
  topicId          Int?
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  createdAt        DateTime @default(now())

  @@map("ai_usage")
}

model SourceMaterial {
  id            Int         @id @default(autoincrement())
  topicId       Int
  topic         Topic       @relation(fields: [topicId], references: [id])
  fileUrl       String
  fileName      String
  fileType      String
  parsedTextUrl String?
  parseStatus   ParseStatus @default(PENDING)
  parseError    String?
  uploadedById  Int
  uploadedBy    User        @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime    @default(now())

  @@map("source_materials")
}

model CourseGroup {
  id       Int          @id @default(autoincrement())
  courseId Int
  course   Course       @relation(fields: [courseId], references: [id])
  groupId  Int
  group    StudentGroup @relation(fields: [groupId], references: [id])

  @@unique([courseId, groupId])
  @@map("course_groups")
}

model Enrollment {
  id        Int              @id @default(autoincrement())
  studentId Int
  student   User             @relation(fields: [studentId], references: [id])
  courseId  Int
  course    Course           @relation(fields: [courseId], references: [id])
  status    EnrollmentStatus @default(ACTIVE)
  createdAt DateTime         @default(now())

  @@unique([studentId, courseId])
  @@map("enrollments")
}
