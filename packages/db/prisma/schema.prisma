generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  FACULTY_ADMIN
  DEPT_ADMIN
  TEACHER
  STUDENT
}

enum Locale {
  uz
  ru
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
}

enum TopicStatus {
  DRAFT
  PUBLISHED
}

enum ParseStatus {
  PENDING
  PROCESSING
  DONE
  ERROR
}

enum ContentKind {
  QUIZ
  CASE
  PRESENTATION
  VIDEO
}

enum ContentStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
}

enum Difficulty {
  RECALL
  UNDERSTAND
  APPLY
}

enum CaseFormat {
  SHORT
  EXTENDED
}

enum VideoBuildStatus {
  PENDING
  SCRIPT
  TTS
  RENDER
  DONE
  ERROR
}

enum FactcheckStatus {
  NONE
  CHECKING
  FLAGGED
  CLEAN
  RESOLVED
}

enum ProgressState {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum TaskStatus {
  OPEN
  DONE
  DISMISSED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

model User {
  id             Int             @id @default(autoincrement())
  fullName       String
  email          String          @unique
  phone          String?
  passwordHash   String
  role           Role
  locale         Locale          @default(uz)
  isActive       Boolean         @default(true)
  groupId        Int?
  group          StudentGroup?   @relation(fields: [groupId], references: [id])
  // Admin-tier scopes: FACULTY_ADMIN is pinned to a faculty, DEPT_ADMIN to a department.
  facultyId         Int?
  faculty           Faculty?        @relation("FacultyAdmins", fields: [facultyId], references: [id])
  adminDepartmentId Int?
  adminDepartment   Department?     @relation("DepartmentAdmins", fields: [adminDepartmentId], references: [id])
  teacherProfile    TeacherProfile?
  taughtCourses     Course[]         @relation("CourseTeacher")
  enrollments       Enrollment[]
  uploadedMaterials SourceMaterial[]
  approvedContent   ContentItem[]    @relation("ContentApprover")
  auditLogs         AuditLog[]
  progress          Progress[]
  overriddenProgress Progress[]      @relation("ProgressOverrider")
  sectionReads      SectionRead[]
  tutorMessages     TutorMessage[]
  quizAttempts      QuizAttempt[]
  caseAttempts      CaseAttempt[]    @relation("CaseStudent")
  reviewedCases     CaseAttempt[]    @relation("CaseReviewer")
  createdSessions   LessonSession[]  @relation("SessionCreator")
  attendanceMarked  Attendance[]     @relation("AttendanceMarker")
  attendanceRecords Attendance[]     @relation("AttendanceStudent")
  aiUsage           AiUsage[]
  tasksCreated      Task[]           @relation("TaskCreator")
  tasksAssigned     Task[]           @relation("TaskAssignee")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@map("users")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  actorId     Int
  actor       User     @relation(fields: [actorId], references: [id])
  action      String
  entity      String
  entityId    Int
  detailsJson Json?
  createdAt   DateTime @default(now())

  @@map("audit_logs")
}

model TeacherProfile {
  id           Int        @id @default(autoincrement())
  userId       Int        @unique
  user         User       @relation(fields: [userId], references: [id])
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  position     String?
  bio          String?
  createdAt    DateTime   @default(now())

  @@map("teacher_profiles")
}

model Faculty {
  id          Int            @id @default(autoincrement())
  name        String
  createdAt   DateTime       @default(now())
  departments Department[]
  groups      StudentGroup[]
  admins      User[]         @relation("FacultyAdmins")

  @@unique([name])
  @@map("faculties")
}

model Department {
  id        Int       @id @default(autoincrement())
  facultyId Int
  faculty   Faculty   @relation(fields: [facultyId], references: [id])
  name      String
  createdAt DateTime  @default(now())
  subjects  Subject[]
  teachers  TeacherProfile[]
  aiUsage   AiUsage[]
  aiQuota   AiQuota?
  admins    User[]           @relation("DepartmentAdmins")

  @@unique([facultyId, name])
  @@map("departments")
}

model AiQuota {
  id                Int        @id @default(autoincrement())
  departmentId      Int        @unique
  department        Department @relation(fields: [departmentId], references: [id])
  monthlyTokenLimit Int        @default(0) // 0 = unlimited
  monthlyImageLimit Int        @default(0)
  monthlyCostLimit  Float      @default(0)

  @@map("ai_quotas")
}

model Subject {
  id           Int        @id @default(autoincrement())
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  name         String
  description  String?
  createdAt    DateTime   @default(now())
  courses      Course[]
  topics       Topic[]

  @@unique([departmentId, name])
  @@map("subjects")
}

model StudentGroup {
  id          Int      @id @default(autoincrement())
  facultyId   Int
  faculty     Faculty  @relation(fields: [facultyId], references: [id])
  name         String
  yearOfStudy  Int
  createdAt    DateTime      @default(now())
  students     User[]
  courseGroups CourseGroup[]

  @@unique([facultyId, name])
  @@map("student_groups")
}

model Course {
  id           Int           @id @default(autoincrement())
  subjectId    Int
  subject      Subject       @relation(fields: [subjectId], references: [id])
  teacherId    Int
  teacher      User          @relation("CourseTeacher", fields: [teacherId], references: [id])
  semester              Int
  academicYear          String
  defaultUnlockRuleJson Json?
  syllabusJson          Json?
  createdAt             DateTime      @default(now())
  courseGroups          CourseGroup[]
  enrollments           Enrollment[]
  sessions              LessonSession[]

  @@map("courses")
}

model Topic {
  id             Int              @id @default(autoincrement())
  subjectId      Int
  subject        Subject          @relation(fields: [subjectId], references: [id])
  title          String
  orderIndex     Int
  status         TopicStatus      @default(DRAFT)
  unlockRuleJson Json?
  hours          Int              @default(0)
  syllabusNote   String?
  createdAt      DateTime         @default(now())
  materials      SourceMaterial[]
  links          TopicLink[]
  digest         TopicDigest?
  contentItems   ContentItem[]
  progress       Progress[]
  sectionReads   SectionRead[]
  tutorMessages  TutorMessage[]
  sessions       LessonSession[]

  @@map("topics")
}

model LessonSession {
  id          Int          @id @default(autoincrement())
  courseId    Int
  course      Course       @relation(fields: [courseId], references: [id])
  topicId     Int?
  topic       Topic?       @relation(fields: [topicId], references: [id])
  date        DateTime
  title       String?
  room        String?
  createdById Int
  createdBy   User         @relation("SessionCreator", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  attendance  Attendance[]

  @@map("lesson_sessions")
}

model Attendance {
  id         Int              @id @default(autoincrement())
  sessionId  Int
  session    LessonSession    @relation(fields: [sessionId], references: [id])
  studentId  Int
  student    User             @relation("AttendanceStudent", fields: [studentId], references: [id])
  status     AttendanceStatus
  grade      Int?
  markedById Int
  markedBy   User             @relation("AttendanceMarker", fields: [markedById], references: [id])
  markedAt   DateTime         @updatedAt

  @@unique([sessionId, studentId])
  @@map("attendance")
}

model Progress {
  id               Int           @id @default(autoincrement())
  studentId        Int
  student          User          @relation(fields: [studentId], references: [id])
  topicId          Int
  topic            Topic         @relation(fields: [topicId], references: [id])
  state            ProgressState @default(LOCKED)
  videoWatchedPct  Int           @default(0)
  videoPositionSec Int           @default(0)
  slidesViewed     Boolean       @default(false)
  completedAt      DateTime?
  overriddenAt     DateTime?
  overriddenById   Int?
  overriddenBy     User?         @relation("ProgressOverrider", fields: [overriddenById], references: [id])
  updatedAt        DateTime      @updatedAt

  @@unique([studentId, topicId])
  @@map("progress")
}

model ContentItem {
  id              Int           @id @default(autoincrement())
  topicId         Int
  topic           Topic         @relation(fields: [topicId], references: [id])
  kind            ContentKind
  language        Locale
  status          ContentStatus @default(DRAFT)
  approvedById       Int?
  approvedBy         User?           @relation("ContentApprover", fields: [approvedById], references: [id])
  approvedAt         DateTime?
  version            Int             @default(1)
  reviewOpenedAt     DateTime?
  editedByTeacher    Boolean         @default(false)
  factcheckFlagsJson Json?
  factcheckStatus    FactcheckStatus @default(NONE)
  factcheckedAt      DateTime?
  createdAt          DateTime        @default(now())
  quiz            Quiz?
  clinicalCase    ClinicalCase?
  presentation    Presentation?
  video           Video?

  @@unique([topicId, kind])
  @@map("content_items")
}

model Video {
  id            Int              @id @default(autoincrement())
  contentItemId Int              @unique
  contentItem   ContentItem      @relation(fields: [contentItemId], references: [id])
  scriptJson    Json
  audioUrl      String?
  mp4Url        String?
  srtUrl        String?
  durationSec   Int?
  voiceId       String?
  language      Locale
  buildStatus   VideoBuildStatus @default(PENDING)
  errorStage    String?

  @@map("videos")
}

model Quiz {
  id            Int         @id @default(autoincrement())
  contentItemId Int         @unique
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id])
  passThreshold Int         @default(70)
  maxAttempts   Int         @default(1)
  /// Vaqt chegarasi (daqiqa). 0 = cheklanmagan. Test boshlanganda
  /// QuizAttempt.expiresAt shunga qarab hisoblanadi.
  timeLimitMin  Int         @default(0)
  settingsJson  Json?
  questions     Question[]
  attempts      QuizAttempt[]

  @@map("quizzes")
}

model QuizAttempt {
  id          Int       @id @default(autoincrement())
  quizId      Int
  quiz        Quiz      @relation(fields: [quizId], references: [id])
  studentId   Int
  student     User      @relation(fields: [studentId], references: [id])
  answersJson Json      @default("{}") // { [questionId]: selectedIndex }
  /// Talaba "belgilab qo'ygan" savollar (keyin qaytish uchun): questionId[].
  flaggedJson Json      @default("[]")
  scorePct    Int       @default(0)
  passed      Boolean   @default(false)
  attemptNo   Int       @default(1)
  startedAt   DateTime  @default(now())
  /// Vaqt tugash momenti (timeLimitMin > 0 bo'lsa). Server shu vaqtdan keyin
  /// urinishni avtomatik yakunlaydi — klient soatiga ishonilmaydi.
  expiresAt   DateTime?
  finishedAt  DateTime?

  @@map("quiz_attempts")
}

model Question {
  id             Int        @id @default(autoincrement())
  quizId         Int
  quiz           Quiz       @relation(fields: [quizId], references: [id])
  text           String
  optionsJson    Json
  correctIndex   Int
  explanationJson Json
  difficulty     Difficulty @default(RECALL)
  sourceFragment String?
  orderIndex     Int

  @@map("questions")
}

model ClinicalCase {
  id            Int           @id @default(autoincrement())
  contentItemId Int           @unique
  contentItem   ContentItem   @relation(fields: [contentItemId], references: [id])
  caseJson      Json
  format        CaseFormat    @default(SHORT)
  attempts      CaseAttempt[]

  @@map("clinical_cases")
}

model CaseAttempt {
  id              Int          @id @default(autoincrement())
  caseId          Int
  clinicalCase    ClinicalCase @relation(fields: [caseId], references: [id])
  studentId       Int
  student         User         @relation("CaseStudent", fields: [studentId], references: [id])
  answersJson     Json // string[] paired with case questions
  submittedAt     DateTime     @default(now())
  teacherFeedback String?
  score           Int?
  reviewedById    Int?
  reviewedBy      User?        @relation("CaseReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?

  @@unique([studentId, caseId])
  @@map("case_attempts")
}

model Presentation {
  id            Int         @id @default(autoincrement())
  contentItemId Int         @unique
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id])
  slidesJson    Json
  pptxUrl       String?
  pdfUrl        String?

  @@map("presentations")
}

model TopicDigest {
  id                Int      @id @default(autoincrement())
  topicId           Int      @unique
  topic             Topic    @relation(fields: [topicId], references: [id])
  digestJson        Json
  version           Int      @default(1)
  approvedByTeacher Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("topic_digests")
}

model AiUsage {
  id               Int         @id @default(autoincrement())
  kind             String
  topicId          Int?
  departmentId     Int?
  department       Department? @relation(fields: [departmentId], references: [id])
  userId           Int?
  user             User?       @relation(fields: [userId], references: [id])
  model            String
  promptTokens     Int         @default(0)
  completionTokens Int         @default(0)
  totalTokens      Int         @default(0)
  images           Int         @default(0)
  ttsChars         Int         @default(0)
  costUsd          Float       @default(0)
  createdAt        DateTime    @default(now())

  @@index([departmentId, createdAt])
  @@map("ai_usage")
}

model SourceMaterial {
  id            Int         @id @default(autoincrement())
  topicId       Int
  topic         Topic       @relation(fields: [topicId], references: [id])
  fileUrl       String
  fileName      String
  fileType      String
  /// Talabaga ko'rsatiladigan metama'lumot ("PDF · 24 bet · 2.1 MB").
  /// pageCount faqat parse aniqlay olsa to'ladi — aks holda UI uni yashiradi
  /// (soxta raqam ko'rsatilmaydi).
  sizeBytes     Int?
  pageCount     Int?
  parsedTextUrl String?
  parseStatus   ParseStatus @default(PENDING)
  parseError    String?
  uploadedById  Int
  uploadedBy    User        @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime    @default(now())

  @@map("source_materials")
}

/// Mavzuga biriktirilgan tashqi manba (darslik bobi, klinik ma'lumotnoma).
/// O'qituvchi qo'shadi; talaba chap panelda "Tashqi havola" sifatida ko'radi.
model TopicLink {
  id        Int      @id @default(autoincrement())
  topicId   Int
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title     String
  url       String
  /// Ixtiyoriy izoh ("Guyton & Hall, 11-bob").
  note      String?
  orderIndex Int     @default(0)
  createdAt DateTime @default(now())

  @@index([topicId])
  @@map("topic_links")
}

/// Dars ichidagi AI-tutor suhbati — talaba + AI (jonli o'qituvchi EMAS,
/// foydalanuvchi spetsifikatsiyasi bo'yicha). Suhbat = (studentId, topicId).
model TutorMessage {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   User     @relation(fields: [studentId], references: [id])
  topicId   Int
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  /// "student" | "assistant"
  role      String
  text      String
  createdAt DateTime @default(now())

  @@index([studentId, topicId, createdAt])
  @@map("tutor_messages")
}

/// Konspekt bo'limi o'qilganini kuzatish (1a "O'qildi 2/6").
/// Progress'dan alohida: Progress mavzu darajasida, bu bo'lim darajasida.
model SectionRead {
  id           Int      @id @default(autoincrement())
  studentId    Int
  student      User     @relation(fields: [studentId], references: [id])
  topicId      Int
  topic        Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  sectionIndex Int
  readAt       DateTime @default(now())

  @@unique([studentId, topicId, sectionIndex])
  @@index([studentId, topicId])
  @@map("section_reads")
}

model CourseGroup {
  id       Int          @id @default(autoincrement())
  courseId Int
  course   Course       @relation(fields: [courseId], references: [id])
  groupId  Int
  group    StudentGroup @relation(fields: [groupId], references: [id])

  @@unique([courseId, groupId])
  @@map("course_groups")
}

model Enrollment {
  id        Int              @id @default(autoincrement())
  studentId Int
  student   User             @relation(fields: [studentId], references: [id])
  courseId  Int
  course    Course           @relation(fields: [courseId], references: [id])
  status    EnrollmentStatus @default(ACTIVE)
  createdAt DateTime         @default(now())

  @@unique([studentId, courseId])
  @@map("enrollments")
}

// Manually-assigned task (admin -> teacher/department, teacher -> student/group).
// Auto-derived tasks are NOT stored here — they are computed live.
model Task {
  id           Int          @id @default(autoincrement())
  title        String
  description  String?
  status       TaskStatus   @default(OPEN)
  priority     TaskPriority @default(NORMAL)
  dueDate      DateTime?
  createdById  Int
  createdBy    User         @relation("TaskCreator", fields: [createdById], references: [id])
  assignedToId Int
  assignedTo   User         @relation("TaskAssignee", fields: [assignedToId], references: [id])
  departmentId Int?
  courseId     Int?
  groupId      Int?
  topicId      Int?
  linkUrl      String?
  batchId      String? // groups a group/department fan-out into one logical assignment
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([assignedToId, status])
  @@index([createdById])
  @@index([batchId])
  @@map("tasks")
}
