generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum Locale {
  uz
  ru
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
}

model User {
  id             Int             @id @default(autoincrement())
  fullName       String
  email          String          @unique
  phone          String?
  passwordHash   String
  role           Role
  locale         Locale          @default(uz)
  isActive       Boolean         @default(true)
  groupId        Int?
  group          StudentGroup?   @relation(fields: [groupId], references: [id])
  teacherProfile TeacherProfile?
  taughtCourses  Course[]        @relation("CourseTeacher")
  enrollments    Enrollment[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("users")
}

model TeacherProfile {
  id           Int        @id @default(autoincrement())
  userId       Int        @unique
  user         User       @relation(fields: [userId], references: [id])
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  position     String?
  bio          String?
  createdAt    DateTime   @default(now())

  @@map("teacher_profiles")
}

model Faculty {
  id          Int            @id @default(autoincrement())
  nameUz      String
  nameRu      String
  createdAt   DateTime       @default(now())
  departments Department[]
  groups      StudentGroup[]

  @@unique([nameUz])
  @@unique([nameRu])
  @@map("faculties")
}

model Department {
  id        Int       @id @default(autoincrement())
  facultyId Int
  faculty   Faculty   @relation(fields: [facultyId], references: [id])
  nameUz    String
  nameRu    String
  createdAt DateTime  @default(now())
  subjects  Subject[]
  teachers  TeacherProfile[]

  @@unique([facultyId, nameUz])
  @@unique([facultyId, nameRu])
  @@map("departments")
}

model Subject {
  id           Int        @id @default(autoincrement())
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  nameUz       String
  nameRu       String
  description  String?
  createdAt    DateTime   @default(now())
  courses      Course[]

  @@unique([departmentId, nameUz])
  @@unique([departmentId, nameRu])
  @@map("subjects")
}

model StudentGroup {
  id          Int      @id @default(autoincrement())
  facultyId   Int
  faculty     Faculty  @relation(fields: [facultyId], references: [id])
  name         String
  yearOfStudy  Int
  createdAt    DateTime      @default(now())
  students     User[]
  courseGroups CourseGroup[]

  @@unique([facultyId, name])
  @@map("student_groups")
}

model Course {
  id           Int           @id @default(autoincrement())
  subjectId    Int
  subject      Subject       @relation(fields: [subjectId], references: [id])
  teacherId    Int
  teacher      User          @relation("CourseTeacher", fields: [teacherId], references: [id])
  semester     Int
  academicYear String
  createdAt    DateTime      @default(now())
  courseGroups CourseGroup[]
  enrollments  Enrollment[]

  @@map("courses")
}

model CourseGroup {
  id       Int          @id @default(autoincrement())
  courseId Int
  course   Course       @relation(fields: [courseId], references: [id])
  groupId  Int
  group    StudentGroup @relation(fields: [groupId], references: [id])

  @@unique([courseId, groupId])
  @@map("course_groups")
}

model Enrollment {
  id        Int              @id @default(autoincrement())
  studentId Int
  student   User             @relation(fields: [studentId], references: [id])
  courseId  Int
  course    Course           @relation(fields: [courseId], references: [id])
  status    EnrollmentStatus @default(ACTIVE)
  createdAt DateTime         @default(now())

  @@unique([studentId, courseId])
  @@map("enrollments")
}
